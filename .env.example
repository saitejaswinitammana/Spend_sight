# SpendSight Environment Configuration

# Optional: Google Gemini API Key for AI Vision receipt extraction.
# If omitted or left empty, SpendSight automatically uses the 100% offline
# rule-based extractor and student template engine.
GEMINI_API_KEY=

# Default student monthly budget goal in dollars
DEFAULT_MONTHLY_BUDGET=650.00

# Privacy setting: Set to true to store receipt images in SQLite.
# Default is false (only corrected structured text/numbers are retained).
SPENDSIGHT_RETAIN_IMAGES=false
